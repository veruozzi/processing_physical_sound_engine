void keyPressed() {
  if (Character.isDigit(key)) {
    int index = Character.getNumericValue(key) - 1; // '1' -> 0, '0' -> -1
    if (index >= 0 && index < driversList.size()) {
      Driver3D driver = (Driver3D) driversList.get(index);
      float f = 10.0;
      // apply a single impulse (use Vect3D to be safe)

      driver.applyFrc(new Vect3D(0, 0, f));
      
      // attempt to get a readable name via reflection, fallback to toString()
      String drvName = driver.toString();
      try {
        java.lang.reflect.Method m = driver.getClass().getMethod("getName");
        Object r = m.invoke(driver);
        if (r != null) drvName = r.toString();
      } catch (Exception e) {
        // ignore, fallback to toString
      }
      println("PLAYING driver[" + index + "] -> " + drvName + " (impulse=" + f + ")");
    }
  }
  // toggle renderer module name display with 'i' (use reflection so missing method won't break compile)
  if (key == 'i') {
    try {
      java.lang.reflect.Method mm = renderer.getClass().getMethod("toggleModuleNameDisplay");
      mm.invoke(renderer);
    } catch (Exception e) {
      // method not available; ignore
    }
  }

  if (key == 'h') showInstructions = !showInstructions;

  // Recording controls: toggle both Minim recorder and miPhysics tap recorder
  if (key == 'r') {
    if (!isRecording) {
      String minimFile = "minim_recording_" + recCount + ".wav";
      String miPhyFile = "miphys_recording_" + recCount + ".wav";
      println("Starting recordings -> " + minimFile + " and " + miPhyFile);
      if (miTapRecorder != null) miTapRecorder.start(miPhyFile);
      isRecording = true;
    } else {
      println("Stopping recordings -> saving files ");
      if (miTapRecorder != null) miTapRecorder.stop();
      isRecording = false;
      recCount++;
      // recreate minim recorder for next session if minim is available
      // minim recorder disabled; miPhysics WAV recorder is used instead
    }
  }

  // Quick capture: press 'c' to make a short timed capture (e.g., 2s)
  if (key == 'c') {
    int durMs = 2000;
    if (!isRecording) {
      String minimFile = "minim_recording_" + recCount + ".wav";
      String miPhyFile = "miphys_recording_" + recCount + ".wav";
      println("Quick capture for " + durMs + " ms -> " + minimFile + " and " + miPhyFile);
      if (miTapRecorder != null) miTapRecorder.start(miPhyFile);
      isRecording = true;
      final int thisRec = recCount;
      new java.lang.Thread(new Runnable() {
        public void run() {
          try { Thread.sleep(durMs); } catch (Exception e) {}
          if (miTapRecorder != null) miTapRecorder.stop();
          isRecording = false;
          recCount++;
          // minim recorder disabled; miPhysics WAV recorder is used instead
        }
      }).start();
    } else {
      println("Already recording - press 'r' to stop first or wait for it to finish.");
    }
  }
}

