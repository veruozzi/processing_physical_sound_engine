void setup() {
    // Screen & Camera
  size(800, 800, P3D);
  cam = new PeasyCam(this, 100);
  cam.setMinimumDistance(50);
  cam.setMaximumDistance(1000);
  cam.setDistance(400);

  phys = new PhysicsContext(48000, displayRate);
  phys.setGlobalGravity(0, 0, 0);
  phys.setGlobalFriction(0.01);

  // Load topology generated by generate_topology.py
  String cfgPath = getConfig();
  println("Loading topology from: " + cfgPath);
  JSONObject topo = loadJSONObject(cfgPath);
  mesh = new PhyModel("mesh", phys.getGlobalMedium());

  // Add masses
  JSONArray masses = topo.getJSONArray("masses");
  // keep a global reference to JSON masses for picking/mapping
  massesJSON = masses;
  // Compute centroid so we can center the model //<>// //<>//
  double sumX = 0, sumY = 0, sumZ = 0;
  for (int i = 0; i < massesJSON.size(); i++) { //<>// //<>//
    JSONObject m = massesJSON.getJSONObject(i);
    sumX += m.getDouble("x");
    sumY += m.getDouble("y"); //<>// //<>//
    sumZ += m.getDouble("z");
  }
  if (massesJSON.size() > 0) {
    centerX = (float)(sumX / massesJSON.size());
    centerY = (float)(sumY / massesJSON.size());
    centerZ = (float)(sumZ / massesJSON.size());
  }

  // Create masses with positions offset so centroid is at origin,
  // and X/Y swapped for the desired on-screen orientation.
  for (int i = 0; i < masses.size(); i++) { //<>// //<>// //<>//
    JSONObject m = masses.getJSONObject(i);
    String id = m.getString("id");
    float x = m.getFloat("x");
    float y = m.getFloat("y");
    float z = m.getFloat("z");
    // massesJSON keeps the original (image-space) coordinates untouched,
    // in case picking/mapping back to the source image is added later.
    float massVal = m.getFloat("mass");
    float radius = m.getFloat("radius");
    // Swapped X/Y, centered on the grid's centroid so PeasyCam (which
    // orbits around world origin by default) always keeps it in frame.
    float worldX = y - centerY;
    float worldY = x - centerX;
    float worldZ = z - centerZ;
    Vect3D pos = new Vect3D(worldX, worldY, worldZ);
    // If mass == 0 -> create a fixed ground node (Ground3D) like the MetalPlate3D example
    if (massVal == 0.0f) {
      // use JSON radius for visualization consistency
      mesh.addMass(id, new Ground3D(radius, pos));
      println("added GROUND:"+id+" with radius:"+radius+" at position:"+pos);
    } else {
      // Use Mass3D for movable/internal nodes
      mesh.addMass(id, new Mass3D(massVal, radius, pos));
      println("added mass:"+id+" with mass value:"+massVal+" and radius:"+radius+" at position:"+pos);
    }
  }

  // Add springs
  //JSONArray springs = topo.getJSONArray("springs");
  //for (int i = 0; i < springs.size(); i++) {
  //  JSONObject s = springs.getJSONObject(i);
  //  String id = s.getString("id");
  //  String a = s.getString("a");
  //  String b = s.getString("b");
  //  float rest = s.getFloat("rest_length");
  //  float stiff = s.getFloat("stiffness");
  //  float damp = s.getFloat("damping");
  //  mesh.addInteraction(id, new SpringDamper3D(rest, stiff, damp), a, b);
 //   println("addes spring:"+id+" between masses:"+a+" and"+b+" with stiffness value:"+stiff+" and damping:"+damp);
  //}
// Add springs – only if they exist in the topology
  if (topo.hasKey("springs")) {
    JSONArray springs = topo.getJSONArray("springs");
    for (int i = 0; i < springs.size(); i++) {
      JSONObject s = springs.getJSONObject(i);
      String id = s.getString("id");
      String a = s.getString("a");
      String b = s.getString("b");
      float rest  = s.getFloat("rest_length");
      float stiff = s.getFloat("stiffness");
      float damp  = s.getFloat("damping");
  
      mesh.addInteraction(id, new SpringDamper3D(rest, stiff, damp), a, b);
      println("added spring:" + id + " between masses: " + a + " and " + b);
    }
  } else {
    println("No 'springs' in topology; skipping spring creation.");
  }

  phys.mdl().addPhyModel(mesh);
  phys.init();

  renderer = new ModelRenderer(this);
  renderer.displayMasses(true);
  renderer.setColor(massType.MASS3D, 105, 100, 250);
  renderer.setColor(interType.SPRINGDAMPER3D, 155, 50, 50, 70);
  renderer.setStrainGradient(interType.SPRINGDAMPER3D, true, 20);
  renderer.setStrainColor(interType.SPRINGDAMPER3D, 255, 250, 255, 255);

    // Create drivers and listeners from sonification metadata in topology.json if available
  driversList = new ArrayList();
  listenersList = new ArrayList();
  driverMassNames = new ArrayList();
    if (topo.hasKey("sonification_set_up")) {
      JSONObject son = topo.getJSONObject("sonification_set_up");
      // drivers: array of identifiers
      if (son.hasKey("drivers")) {
        JSONArray drv = son.getJSONArray("drivers");
        for (int i = 0; i < drv.size(); i++) {
          String id = drv.getString(i);
          Mass m = mesh.getMass(id);
          if (m != null) {
            Driver3D d = mesh.addInOut("driver"+i, new Driver3D(), id);
            driversList.add(d);
            driverMassNames.add(id);
            println("driver:"+id);
          }
          }
        }
      if (son.hasKey("listeners")) {
        JSONArray lst = son.getJSONArray("listeners");
        for (int i = 0; i < lst.size(); i++) {
          String id = lst.getString(i);
          Mass m = mesh.getMass(id);
          if (m != null) {
            Observer3D o = mesh.addInOut("listener"+i, new Observer3D(), id);
            listenersList.add(o);
            println("listener:" + id);
          }
        }
      }
      }

  oscP5 = new OscP5(this, port1DModel);
  
  // Use the helper in AudioHandler.pde to create a tapped audio client and recorder
  setAudioClient();

  // Choose which listener data to use: force-based listeners or position-based listeners.
  // Uncomment one of the following depending on whether you want to listen to forces or positions.
  // Default: listen to forces
  audioStreamHandler.listenFrc();                  // or audioStreamHandler.listenPos();
  audioStreamHandler.setListenerAxis(listenerAxis.ALL);
}

