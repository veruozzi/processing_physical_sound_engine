// Helper: determine configuration JSON path from environment or fall back to default
String getConfig() {
  String conf_path = System.getenv("ULTRASONIX_CONF");
  //String defaultPath = "/mnt/3AB8D1B3B8D16DBF/BioSonixData/US-Imgs/Acquisition_convex_liver_breast_kidney/Insertion/04/config_full_2D.json";
  String defaultPath = "/mnt/3AB8D1B3B8D16DBF/BioSonixData/US-Imgs/Acquisition_convex_liver_breast_kidney/Insertion/31/config_31.json";

  // If the environment variable isn't set, try the repo-local default path.
  if (conf_path == null) {
    if (new java.io.File(defaultPath).exists()) {
      println("Using default config: " + defaultPath);
      return defaultPath;
    } else {
      println("No ULTRASONIX_CONF env var and default config not found. Expecting: " + defaultPath);
      return defaultPath; // still return default so caller can show error if missing
    }
  }

  // If the env var is set but the file doesn't exist, warn the user and fall back
  if (!new java.io.File(conf_path).exists()) {
    println("ULTRASONIX_CONF is set to '" + conf_path + "' but that file does not exist. Falling back to default.");
    return defaultPath;
  }

  return conf_path;
}
